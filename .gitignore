# Local environments and generated caches
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
/build/
/dist/
*.egg-info/
.DS_Store

# Data, outputs, trained models and runtime state (keep *.dvc pointer files)
/data/**
!/data/**/*.dvc
!/data/**/
/processed/
/artifacts/
/results/
/checkpoints/
/models/
/outputs/
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.tar.gz
/mlruns/
/mlartifacts/
*.duckdb
*.duckdb.wal
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite3-*
*.log

# DVC metadata/pipeline files remain trackable; local caches/config do not
/.dvc/cache/
/.dvc/tmp/
/.dvc/config.local

# Local credentials / machine settings; examples can be reviewed into Git
.env
.env.*
!.env.example
!.env.sample
.aws/
.ssh/
kaggle.json
credentials.json
*.pem
*.key
*.p12
*.pfx

# Preserve visibility of previously archived models; never silently hide legacy files
!/archive/**/*.safetensors
!/archive/**/*.pth
!/archive/**/*.pt
!/archive/**/*.ckpt
!/archive/**/*.onnx
!/archive/**/*.db
!/archive/**/*.sqlite
!/archive/**/*.sqlite3
